---
import { formatData, formatDistanza, formatDislivello, categoriaColor, disciplinaIcon, formatCategoria, getRaceColorForBorder, WT_COLOR, CATEGORIA_COLORS, campionatoTheme, countryFlagCode, campionatoFlagOpacity, isNatChamp, NAT_LABEL, dateRange, formatDateRange } from '../lib/gare.js';
const { gara } = Astro.props;
const isCorsaATappe = gara.tipo === 'corsa_a_tappe';
const isCampionato = gara.tipo === 'campionato';
const isContenitore = isCorsaATappe || isCampionato;
const isTipoPista = gara.disciplina === 'Tipo pista';
const icon  = disciplinaIcon(gara.disciplina);
const base  = import.meta.env.BASE_URL.replace(/\/$/, '');
const categorie: string[] = (Array.isArray(gara.categoria) ? gara.categoria : [gara.categoria]).filter(Boolean);

// Verifica se è una gara speciale (Giro d'Italia Women)
const isSpecialWTRace = gara.slug?.includes('giro-d-italia-women');

// Skin dedicata campionati (Mondiale/Europeo), guidata dai dati e non dallo slug
const theme = isCampionato ? campionatoTheme(gara.livello) : null;
// NAT Champ: gara singola (una prova) marcata livello "Nazionale" + paese. Diversamente da
// Mondiali/Europei mantiene colore categoria e filtri normali: cambia solo badge e bandiera.
const isNat = isNatChamp(gara);
const flagCode = (isCampionato || isNat) ? (gara.paese || countryFlagCode(gara.luogo)) : null;
const flagOpacity = (isCampionato || isNat) ? campionatoFlagOpacity(gara.livello) : 0;

// Date: range per corse a tappe e campionati (Mondiale/Europeo), data singola per il resto
const range = dateRange(gara);

// Mappa colori per categorie: unica fonte in lib/gare.js (CATEGORIA_COLORS)
const catColorMap = CATEGORIA_COLORS;

// Genera il colore/gradiente per il bordo
const borderStyle = getRaceColorForBorder(gara);

// Shade colore genere
const genereColor = gara.genere === 'Femminile'
  ? 'radial-gradient(ellipse at 100% 0%, rgba(225,0,100,0.14) 0%, rgba(225,0,100,0.05) 35%, transparent 65%)'
  : 'radial-gradient(ellipse at 100% 0%, rgba(80,150,215,0.22) 0%, rgba(80,150,215,0.08) 35%, transparent 65%)';
---

<a href={`${base}/gare/${gara.slug}/`} class={`card${isCorsaATappe ? ' card--tappe' : ''}${isSpecialWTRace ? ' card--special' : ''}${theme ? ' card--campionato' : ''}${isNat ? ' card--nat' : ''}${flagCode ? ' card--flag' : ''}`} style={`--cat-color: ${theme ? theme.gradient : borderStyle}; --genere-shade: ${genereColor}; ${theme ? `--campionato-accent: ${theme.accent};` : ''} ${flagCode ? `--campionato-flag: url(https://flagcdn.com/w640/${flagCode}.png); --campionato-flag-opacity: ${flagOpacity};` : ''}`}>
  {flagCode && <div class="card-flag-bg" aria-hidden="true"></div>}

  <div class="card-top">
    <div class="cat-badges">
      {theme ? (
        <span class="cat-badge campionato-badge">{theme.label}</span>
      ) : gara.wt ? (
        <span class="cat-badge wt-badge" style={`--badge-color: ${WT_COLOR}`}>World Tour</span>
      ) : (
        <>
          {isNat && <span class="cat-badge campionato-badge nat-badge">{NAT_LABEL}</span>}
          {categorie.map((cat) => (
            <span class="cat-badge" data-cat={cat} style={`--badge-color: ${catColorMap[cat] ?? '#888'}`}>{formatCategoria(cat, gara.genere)}</span>
          ))}
        </>
      )}
    </div>
    {isContenitore
      ? <span class="disc-badge tappe-badge">⛰ {gara.n_tappe} {isCampionato ? 'prove' : 'tappe'}</span>
      : <span class="disc-badge">{icon} <span class="disc-badge-text" data-disc={gara.disciplina ?? ''}>{gara.disciplina ?? '—'}</span></span>
    }
    <span class="genere-badge" class:list={{ 'genere-badge--special': isSpecialWTRace || isCampionato }}>{gara.genere === 'Femminile' ? '♀' : (gara.genere === 'Maschile' ? '♂' : '♀♂')}</span>
  </div>

  <h2 class="card-title">{gara.titolo}</h2>

  <div class="card-sub">
    {gara.luogo && <span class="luogo">{gara.luogo}</span>}
    <span class="anno">{new Date(gara.data).getFullYear()}</span>
  </div>

  <div class="card-stats">
    {isTipoPista ? (
      gara._base_km && (
        <div class="stat">
          <span class="stat-v">{formatDistanza(gara._base_km)}</span>
          <span class="stat-l">dist lap</span>
        </div>
      )
    ) : (
      gara.distanza_km && (
        <div class="stat">
          <span class="stat-v">{formatDistanza(gara.distanza_km)}</span>
          <span class="stat-l">{isContenitore ? 'tot dist' : 'dist'}</span>
        </div>
      )
    )}
    {isTipoPista ? (
      gara._base_elev && (
        <div class="stat">
          <span class="stat-v">{formatDislivello(gara._base_elev)}</span>
          <span class="stat-l">D+ lap</span>
        </div>
      )
    ) : (
      gara.dislivello_m && (
        <div class="stat">
          <span class="stat-v">{formatDislivello(gara.dislivello_m)}</span>
          <span class="stat-l">{isContenitore ? 'tot D+' : 'D+'}</span>
        </div>
      )
    )}
    {range.start && (
      <div class="stat stat-date">
        <span class="stat-v">{formatDateRange(range)}</span>
        <span class="stat-l">data</span>
      </div>
    )}
  </div>

  <span class="card-cta">{isCampionato ? 'Vedi prove →' : (isCorsaATappe ? 'Vedi tappe →' : 'Apri percorso →')}</span>
</a>

<style>
  .card {
    display: flex; flex-direction: column; gap: 0.5rem;
    background: var(--surface);
    border: 1px solid var(--border);
    border-top: none;
    padding: 1.25rem 1.5rem 1rem;
    cursor: pointer; position: relative;
    transition: transform 0.15s, box-shadow 0.15s;
    overflow: hidden;
  }

  /* Striscia categoria in cima */
  .card::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 3px;
    background: var(--cat-color);
  }

  .card-flag-bg {
    position: absolute; inset: 0; z-index: 0; pointer-events: none;
    background-image: var(--campionato-flag);
    background-size: cover; background-position: center;
    opacity: var(--campionato-flag-opacity, 0.08);
  }
  .card--flag > *:not(.card-flag-bg) { position: relative; z-index: 1; }

  /* Shade genere — angolo alto destra, si dissolve */
  .card::after {
    content: '';
    position: absolute;
    top: 0;
    right: 0;
    width: 60%;
    height: 60%;
    background: var(--genere-shade);
    pointer-events: none;
  }

  .card:hover {
    transform: translateY(-2px);
    box-shadow: 0 6px 24px rgba(0,0,0,0.1);
  }

  .card-top { display: flex; align-items: center; gap: 0.5rem; position: relative; z-index: 1; }

  .cat-badges {
    display: flex;
    gap: 0.3rem;
    flex-wrap: wrap;
  }

  .cat-badge {
    font-family: var(--font-mono); font-size: 0.65rem;
    text-transform: uppercase; letter-spacing: 0.1em;
    color: var(--badge-color);
    background: rgba(0,0,0,0.04);
    border: 1px solid rgba(0,0,0,0.12);
    padding: 0.2rem 0.55rem; border-radius: 2px;
  }

  .disc-badge {
    font-family: var(--font-mono); font-size: 0.65rem;
    color: var(--text2); background: var(--bg3);
    border: 1px solid var(--border);
    padding: 0.2rem 0.55rem; border-radius: 2px;
  }

  .genere-badge { font-size: 0.75rem; color: var(--text3); margin-left: auto; }

  .genere-badge--special {
    font-size: 0.75rem;
    color: var(--text3);
  }

  .card--special {
    background: linear-gradient(135deg, rgba(255, 40, 110, 0.40) 0%, rgba(255, 40, 110, 0.20) 100%);
    color: #333;
    border-color: rgba(224, 27, 93, 0.4);
  }

  .card--special .card-title,
  .card--special .card-cta,
  .card--special .stat-v,
  .card--special .card-sub {
    color: #333;
  }

  .card--special .card-sub,
  .card--special .stat-l,
  .card--special .genere-badge {
    color: #666;
  }

  .card--special .cat-badge,
  .card--special .disc-badge {
    background: rgba(255, 255, 255, 0.2);
    border-color: rgba(255, 255, 255, 0.4);
    color: #fff;
  }

  .card--special .card-stats {
    border-top-color: rgba(255, 255, 255, 0.3);
  }

  .card-title {
    font-family: var(--font-display);
    font-size: 1.2rem; font-weight: 700; line-height: 1.15;
    letter-spacing: -0.01em; color: var(--text);
    margin-top: 0.25rem;
  }

  .card-sub { display: flex; align-items: center; gap: 0.75rem; font-size: 0.78rem; color: var(--text2); }
  .luogo::before { content: '↗ '; }
  .anno { font-family: var(--font-mono); font-size: 0.72rem; color: var(--text3); margin-left: auto; }

  .card-stats {
    display: flex; gap: 1.25rem;
    margin-top: 0.5rem; padding-top: 0.75rem;
    border-top: 1px solid var(--border);
  }

  .stat { display: flex; flex-direction: column; gap: 0.15rem; }
  .stat-v { font-family: var(--font-mono); font-size: 0.85rem; font-weight: 500; color: var(--text); }
  .stat-l { font-family: var(--font-mono); font-size: 0.58rem; text-transform: uppercase; letter-spacing: 0.1em; color: var(--text3); }
  .stat-date { margin-left: auto; align-items: flex-end; }
  .stat-date .stat-v { white-space: nowrap; }

  .card-cta {
    font-family: var(--font-mono); font-size: 0.65rem;
    text-transform: uppercase; letter-spacing: 0.1em;
    color: var(--text3); margin-top: 0.25rem;
    transition: color 0.15s;
  }
  .card:hover .card-cta { color: var(--accent); }

  .tappe-badge {
    background: rgba(212, 64, 26, 0.08);
    border-color: rgba(212, 64, 26, 0.25);
    color: var(--accent);
    font-weight: 500;
  }

  .card--tappe {
    border-left: 2px solid var(--accent);
  }

  /* ── Skin campionati (Mondiale / Europeo) ── */
  .card--campionato {
    border-left: 2px solid var(--campionato-accent, var(--accent));
  }

  .card--campionato::before {
    height: 4px;
  }

  /* ── NAT Champ (gara singola): bordo sinistro scuro, il resto resta da categoria ── */
  .card--nat {
    border-left: 2px solid var(--nat-accent, #1A1A1A);
  }
  /* Con NAT Champ + due categorie la riga badge è affollata: i badge vanno a capo tra loro,
     la disciplina resta su una riga sola */
  .card--nat .cat-badges { flex: 1; min-width: 0; }
  .card--nat .disc-badge { white-space: nowrap; flex-shrink: 0; }

  .campionato-badge {
    font-family: var(--font-mono); font-size: 0.65rem;
    text-transform: uppercase; letter-spacing: 0.1em;
    font-weight: 700;
    color: #fff;
    background: var(--campionato-accent, #333);
    border: 1px solid rgba(0,0,0,0.15);
    padding: 0.2rem 0.55rem; border-radius: 2px;
  }
</style>